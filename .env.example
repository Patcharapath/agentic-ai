# Copy this file to ".env" and fill in what you use. Never share or commit ".env".

# Which LLM the labs use by default: ollama | openrouter | groq | google
LLM_PROVIDER=ollama

# --- Local model (Ollama) ---
OLLAMA_MODEL=qwen3.5:4b
# Context window Ollama allocates, in tokens. Larger needs more RAM.
OLLAMA_NUM_CTX=8192
# Longest answer the local model may write, in tokens. Stops runaway generation.
OLLAMA_NUM_PREDICT=1024
# Let the model think step by step before answering: true | false. Slower when true.
OLLAMA_THINK=false
# OLLAMA_BASE_URL=http://localhost:11434

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google AI Studio (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
